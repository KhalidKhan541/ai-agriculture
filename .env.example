# Core
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_agriculture?schema=public"
DATABASE_DIRECT_URL="postgresql://postgres:password@localhost:5432/ai_agriculture?schema=public"

# Auth
NEXTAUTH_SECRET=your-secret-key-min-32-characters-long-here!
NEXTAUTH_URL=http://localhost:3000

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ai-agriculture.com

# Redis
REDIS_URL=

# S3 Storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Weather API
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Satellite
SATELLITE_API_KEY=
SATELLITE_API_URL=

# Mapbox
MAPBOX_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI / ML
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ML_API_URL=
ML_API_KEY=

# Logging
LOG_LEVEL=debug
SERVICE_NAME=ai-agriculture

# Features
ENABLE_SATELLITE=false
ENABLE_DRONE=false
ENABLE_IOT=true
ENABLE_AI=true
ENABLE_MARKETPLACE=true
ENABLE_WEBSOCKET=true
